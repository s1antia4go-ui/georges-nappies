# Copy to backend/.env and fill in. Never commit the real .env.
ENVIRONMENT=development
# Use a dedicated, non-superuser PostgreSQL role that owns only this database.
DATABASE_URL=postgresql+asyncpg://gn_app:CHANGE_ME@127.0.0.1:5432/georges_nappies
TEST_DATABASE_URL=postgresql+asyncpg://gn_app:CHANGE_ME@127.0.0.1:5432/georges_nappies_test
# Origins allowed to call the API / open the WebSocket (CSRF + CSWSH protection).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# Base URL used in password-reset emails.
PUBLIC_URL=http://localhost:5173
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Optional: SMTP for password-reset emails. Without it, reset links go to the server log (dev only).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=George's Nappies <no-reply@example.com>
