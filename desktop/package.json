{
  "name": "georges-nappies-desktop",
  "productName": "George's Nappies",
  "version": "1.4.0",
  "description": "George's Nappies messaging app for Windows",
  "author": "Santiago Rojas",
  "main": "main.js",
  "private": true,
  "serverUrl": "https://georges-nappies.onrender.com",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.georgesnappies.desktop",
    "productName": "George's Nappies",
    "copyright": "Made by Santiago Rojas",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "package.json", "build/icon.png", "build/icon.ico", "build/brand.woff2"],
    "win": { "target": ["nsis"], "icon": "build/icon.ico", "publisherName": "Santiago Rojas" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "runAfterFinish": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "George's Nappies",
      "uninstallDisplayName": "George's Nappies",
      "artifactName": "GeorgesNappies-Setup.exe",
      "deleteAppDataOnUninstall": false
    }
  }
}
